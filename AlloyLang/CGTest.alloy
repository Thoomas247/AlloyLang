
type List(type T) = struct
{
	capacity: u64,
	size: u64,
};

fn List(type T):create(const size: u64, const capacity: u64) -> List(T)
{
	return List(T) { capacity = capacity, size = size };
}

fn main() -> i64
{
	var l : List(i32) = List(i32):create(10, 20);

	return 0;
}

