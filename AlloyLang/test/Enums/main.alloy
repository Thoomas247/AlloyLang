extern printf (const str : String, ...) -> i64;

type EnumType(type T) = enum
	{
		ValueA: T,
		ValueB: f64,
		ValueC,	// no payload
		ValueD: T,	// same payload as ValueA
	};

fn main() -> i32
{
	var enumVar = EnumType(i32)|ValueA(43);
	var enum2Var = EnumType(i64)|ValueB(2.54);
	var enum3Var = EnumType(i32)|ValueC;

	if (enumVar == EnumType(i32)|ValueA) -> num
	{
		if (enum2Var == EnumType(i64)|ValueB) -> fnum
		{

			switch (enumVar)
			{
				case (EnumType(i32)|ValueA) -> num	// capture is optional, and can be omitted even when there is a payload, in which case the payload is inaccessible
				{
					// use num
					printf("payload A is %d", num);
				}

				// no fallthrough between cases!
				case (EnumType(i32)|ValueB) -> num
				{
					// use num2
					printf("payload B is %d", num);
				}

				case (EnumType(i32)|ValueC)	// ValueC has no payload, cannot capture
				{
			
				}
			}
			printf("enums are equal, payload A is %d, payload B is %f", num, fnum);
					return num;
		}
		else
		{
			printf("Only enumA of type i32 was equal!");
			return 0;
		}
	}
	else
	{
		printf("enums are not equal, cannot get payload");
		return 0;	
	}
}
