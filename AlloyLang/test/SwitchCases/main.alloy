extern printf (const str : String, ...) -> i64;

fn main () -> i64
{
	var res : i64 = 0;
	var test32 : i32 = 1;

	var test = test32:cast<i64>();	// small extra test for the cast functions

	switch (test)
	{
		case (2)
		{
			printf("Error %d!", test);
			res = 2;
		}
		case (1)
		{
			printf("Success %d!", test);
			res = 1;
		}
	}

	return res;
}
