fn increment_scores(const score_array: &ScoreArray)
{
	for (var i: u64 = 0; i < score_array.size; i = i + 1)
	{
		var current_score = score_array:get(i);

		current_score = current_score + 5;

		if (current_score % 7 == 0)
		{
			current_score = current_score - 3;
		}
	}
}