import lib::math;
import lib::array;

extern printf(const fmt: String, ...);

type Transform = struct
{
	position:	FVec3,
	rotation:	Quat,
	scale:		FVec3,
};

fn Transform:create() -> Transform
{
	return Transform { position = FVec3:create(), rotation = Quat:create(), scale = FVec3:create() };
}

fn Transform:get_transform_matrix(const self: &Self) -> Mat4
{
	return Mat4:create_identity();
}

type TransformArray = [Transform; 256];
type ScoreArray = Array<u32>;

type Data = struct
{
	score_array:		ScoreArray,
	transform_array:	Array<Transform>,
};

fn Data:create() -> Data
{
	return Data { score_array = ScoreArray:create(), transform_array = Array<Transform>:create() };
}

fn main() -> i32
{
	printf("Hello World!");

	var x: i32 = 25;
	var y = x:cast<u32>();

	var data = Data:create();
	data.score_array:add(5);

	var score_array = ScoreArray:create();
	score_array:resize_fill(10, 20);

	while (x > 0)
	{
		increment_scores(&score_array);
		x = x - 1;
	}

	printf("Current score = %d", score_array.data[5]);

	return score_array.data[5];
}

fn increment_scores(const score_array: &ScoreArray)
{
	for (var i: u64 = 0; i < score_array.size; i = i + 1)
	{
		var current_score = score_array:get(i);

		current_score = current_score + 5;

		if (current_score % 7 == 0)
		{
			current_score = current_score - 3;
		}
	}
}
