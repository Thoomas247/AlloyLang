import lib::math;
import lib::array;

extern printf(const fmt: String, ...);

type Transform = struct
{
	position:	FVec3,
	rotation:	Quat,
	scale:		FVec3,
};

fn Transform:create() -> Transform
{
	return Transform { position = FVec3:create(), rotation = Quat:create(), scale = FVec3:create() };
}

fn Transform:get_transform_matrix(const self: &Self) -> Mat4
{
	return Mat4:create_identity();
}


type TransformArray = [Transform; 256];
type ScoreArray = Array<u32>;


