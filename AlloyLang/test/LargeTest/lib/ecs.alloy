type Entity = u32;

// container for a single component type
pub type SparseSet(type T) = struct
{
	sparse:			Array(Entity),
	dense:			Array(Entity),
	components:		Array(T),
};

// returns whether the given entity is in this set
pub fn SparseSet(type T):contains_entity(const self: &Self, const entity: Entity) -> bool
{
	/*
	if (entity >= self.sparse.size)
	{
		return false;
	}

	return self.dense:at(self.sparse:at(entity)) == entity;
	*/

	return true;
}

// adds the given entity and component to the set
// if the entity is already in the set, its component will be overridden
pub fn SparseSet(type T):add_entity(var self: &Self, const entity: Entity, const component: &T) -> var &T
{
	/*
	if (!self:contains_entity(entity))
	{
		const pos = self.dense.size;
		self.dense:add(entity);
		self.sparse:at(entity) = pos;
	}

	else
	{
		
	}

	*/
}