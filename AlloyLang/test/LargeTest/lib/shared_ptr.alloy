type Nullable<type T> = enum
{
	Null,
	Value: T,
};


// -- SharedPtr -- //

pub type SharedPtr<type T> = struct
{
	data:		&T,
	controller: &SharedPtrController<T>,
};

pub fn SharedPtr<type T>:create(var data_ptr: *T)
{
	var spc = SharedPtrController<T>:create(data_ptr);

	return spc:make_shared();
}

