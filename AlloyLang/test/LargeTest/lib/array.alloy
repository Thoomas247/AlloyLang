pub type Array<type T> = struct
{
	capacity:	u64,
	size:		u64,
	data:		*[T],
};

pub fn Array<type T>:create() -> Array<T>
{
	return Array<T> { size = 0, data = new {} };
}

pub fn Array<type T>:resize_fill(var self: &Self, const new_size: u64, const value: &T)
{
	if (self.size == new_size)
	{
		return;
	}

	self.capacity = new_size;

	var new_data: *[T] = new [value; self.capacity];

	// copy over to new array
	for (var i: u64 = 0; i < self.size; i = i + 1)
	{
		new_data[i] = self.data[i];
	}

	self.data = move new_data;
	self.size = new_size;
}

pub fn Array<type T>:get(var self: &Self, const index: u64) -> var &T
{
	return &self.data[index];
}

pub fn Array<type T>:add(var self: &Self, const new_obj: &T)
{
	// check if we reached max capacity
	if (self.size == self.capacity)
	{
		self.capacity = self.capacity * 2;

		var new_data: *[T] = new [T:create(); self.capacity];

		// copy over to new array
		for (var i: u64 = 0; i < self.size; i = i + 1)
		{
			new_data[i] = self.data[i];
		}

		self.data = move new_data;
	}

	self.data[self.size] = new_obj;
	self.size = self.size + 1;
}

pub fn Array<type T>:remove(var self: &Self, const index: u64)
{
	for (var i = index; i < self.size - 1; i = i + 1)
	{
		self.data[i] = self.data[i + 1];
	}

	self.size = self.size - 1;
}