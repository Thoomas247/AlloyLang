extern printf (const str: String, ...) -> i64;

fn Compare<type T1>(var a : T1, var b : T1) -> i64
{
	if (a == b)
		return 0;
	else
	{
		if (a > b)
			return 1;
		else
			return -1;
	}
}

fn main () -> i64
{
	var a : i32 = 2;
	var b : i32 = 3;

	var a1 : f64 = 2.5;
	var b1 : f64 = 1.5;
	var result : i64 = Compare<i32>(a, b) + Compare<f64>(a1, b1);

	printf("Result = %d", result);
	return result;		// should be 0
}

