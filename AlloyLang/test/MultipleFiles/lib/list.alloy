
exp type List(type T) = struct
{
	capacity: u64,
	size: u64,
	arr: *[T; 1],
};

exp fn List(type T):create(const default: &T, const capacity: u64)
{
	return List(T) { capacity = capacity, size = 0, arr = new [default; capacity] };
}

exp fn List(type T):add(var self: &Self, const value: &T)
{
	if (self.size == self.capacity) return;

	self.arr[self.size] = value;

	self.size = self.size + 1;
}