extern fn printf (const str : String, ...) -> i64;


/* Math Utilities */

struct Vector3
{
	var x : f64;
	var y : f64;
	var z : f64;
}

struct Quaternion
{
	var x : f64;
	var y : f64;
	var z : f64;
	var w : f64;
}

fn Vector3_print(const v : &Vector3)
{
	printf("[ %f, %f, %f ]", v.x, v.y, v.z);
}

fn Vector3_translate(const point : Vector3, const vector : Vector3) -> Vector3
{
	var result : Vector3 = Vector3 { x = 0.00, y = 0.00, z = 0.00 };
					
	result.x = point.x + vector.x;
	result.y = point.y + vector.y;
	result.z = point.z + vector.z;
					
	return result;
}


/* Rendering Utilities */

fn draw_mesh(const vertices : *[Vector3], const num_vertices : u32, const indices : *[i32], const num_indices : u32, const color : Vector3)
{
	printf("Drawing mesh with %d vertices and %d indices and with color (%lf, %lf, %lf).\n", num_vertices, num_indices, color.x, color.y, color.z);
}


/* Scene Resources */

resource RootEntity
{
	var id : i32;
}

resource CurrentScene
{
	var id : i32;
}


/* Transform Components */

component LocalTransform
{
	var position : Vector3;
	var rotation : Quaternion;
	var scale : Vector3;
}

component WorldTransform
{
	var position : Vector3;
	var rotation : Quaternion;
	var scale : Vector3;
}


/* Hierarchical Components */

component Parent
{
	var parent : i32;

	require { Child, Sibling }
}

component Child
{
	var first_child : i32;

	require { Parent, Sibling }
}

component Sibling
{
	var next_sibling : i32;

	require { Parent, Child }
}


/* Rendering Components */

component Mesh
{
	var vertices : *[Vector3];
	var indices : *[i32];
}

component Material
{
	var shader_index : i32;
	var color : Vector3;
}


/* Physics Components */

component RigidBody
{
	var mass : f64;
	var velocity : Vector3;
	var angular_velocity : Vector3;
}

component Collider
{
	var shape : i32;
}


/* AI Components */

// simple flag components to mark entities as enemies or allies
component EnemyAI
{
	require { WorldTransform }
	exclude { AllyAI }
}

component AllyAI 
{
	exclude { EnemyAI }
}


/* Systems */

query SceneQuery
{
	const CurrentScene;

	var WorldTransform;
}

system load_scene(SceneQuery)
{
	printf("Loading scene.\n");
}

query TransformHierarchyQuery
{
	const RootEntity;

	var WorldTransform;
	const LocalTransform;
	const Child;
	const Sibling;
}

system calculate_world_transforms(TransformHierarchyQuery)
{
	printf("Calculating world transforms.\n");
}


query RenderQuery
{
	const WorldTransform;
	const Mesh;
	const Material;
}

system render(RenderQuery)
{
	printf("Rendering meshes.\n");
}


query PhysicsQuery
{
	const WorldTransform;
	const RigidBody;
	const Collider;
}

system update_physics(PhysicsQuery)
{
	printf("Updating physics.\n");
}


query EnemyAIQuery
{
	var WorldTransform;
	const EnemyAI;
}

query AllyAIQuery
{
	var WorldTransform;
	const AllyAI;
}

system update_enemy_AI(EnemyAIQuery)
{
	printf("Updating enemy AI.\n");
}

system update_ally_AI(AllyAIQuery)
{
	printf("Updating ally AI.\n");
}

system save()
{
	printf("Saving game.\n");
}


/* Groups */

group PreStartGroup
{
	load_scene
}

group StartGroup
{
	calculate_world_transforms
}

group UpdateGroup
{
	update_physics,
	update_enemy_AI,
	update_ally_AI
}

group RenderGroup
{
	render
}

group EndGroup
{
	save
}


/* Application */

application App
{
	start
	{
		PreStartGroup,
		StartGroup
	}

	update
	{
		UpdateGroup,
		RenderGroup
	}

	end
	{
		EndGroup
	}
}
