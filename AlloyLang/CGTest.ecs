		extern fn printf (const str : String, const param : i64) -> i64;
	
		fn test (var a : i64, var b : &i64) -> i64
		{
			b = a;
			return a;
		}
	
		fn main () -> i64
		{				
			var a : i64 = 3;
			var b : i64 = 0;
			test(a, b);
			printf("b = %d", b);
			if (b == 3)
				return 1;
			else
				return 0;
		}
