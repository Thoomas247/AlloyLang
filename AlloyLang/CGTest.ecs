}

// the 'Any' type can be used to specify that a parameter can be of any type
fn serialize(const obj: &Any)
{
	// do serialization...
}

// generics can be used in member functions in the same ways as in normal functions
// they can also be used to add a member function to any type
fn Any:serialize(const obj: &Self)
{
	// do serialization...
}

// the type of a parameter can be obtained via the @type_of() macro used on a previous parameter
fn compare(const objA: &Any, const objA: &@type_of(objA)) -> i32
{
	// do comparison...
}

// otherwise, a type can be explicitly passed in
fn try_cast(const obj: &Any, type To) -> Result(To)
{
	// try to cast...

	return Result(To) { success = false, value = To {} };
}


/* Main */

fn main() -> i64
{
	var vec = Vector3 { x = 0, y = 0, z = 0 };

	renderer::opengl:Init();

	vec = Vector3:translate(&vec, Vector3 { x = 10, y = -3, z = 2 });
	vec:print();

	return 0;
}