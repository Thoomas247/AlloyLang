import util::misc;		// bring every public or exported symbol from util::math into this scope
						// similar to doing "using namespace ..." in C++
						// not required to access symbols in other files

extern printf (const str: String, ...) -> i64;

/* Macros */

type Entity = u64;

macro make_ptr_array(type T) -> type
{
	return [*T];
}

macro test_macro(type T) -> type
{
	type ptrArrayT = @make_ptr_array(T);

	return struct { ptrArray: ptrArrayT };
}


/* Math Utilities */

type Vector3 = struct
{
	x: f64,
	y: f64,
	z: f64,
};

type Quaternion = struct
{
	x: f64,
	y: f64,
	z: f64,
	w: f64,
};

fn Quaternion:rotate(var q: &Quaternion)
{
	
}

fn Quaternion:lerp(const qA: &Quaternion, const qB: &Quaternion, const t: &f64) -> Quaternion
{
	var q: Quaternion = Quaternion { x = 0, y = 0, z = 0, w = 0 };

	q.x = qA.x + (qB.x - qA.x) * t;
	q.y = qA.y + (qB.y - qA.y) * t;
	q.z = qA.z + (qB.z - qA.z) * t;
	q.w = qA.w + (qB.x - qA.w) * t;

	return q;
}

fn Vector3:print(const v : &Self)
{
	printf("[ %f, %f, %f ]", v.x, v.y, v.z);
}

fn Vector3:translate(const point : &Vector3, const vector : &Vector3) -> Vector3
{
	var result = Vector3 { x = 0.00, y = 0.00, z = 0.00 };
					
	result.x = point.x + vector.x;
	result.y = point.y + vector.y;
	result.z = point.z + vector.z;
					
	return result;
}


/* Generics */

// types can be made generic
type Result(type T) = struct
{
	success: bool,
	value: T
};

fn Result(type T):some_func()
