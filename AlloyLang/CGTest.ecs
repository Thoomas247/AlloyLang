/* Macros */

type Entity = u64;

macro make_ptr_array(type T) -> type
{
	return [*T];
}

macro test_macro(type T) -> type
{
	type ptrArrayT = @make_ptr_array(T);

	return struct { ptrArray: ptrArrayT, };
}


/* Math Utilities */

type Vector3 = struct
{
	x: f64,
	y: f64,
	z: f64,
};

type Quaternion = struct
{
	x: f64,
	y: f64,
	z: f64,
	w: f64,
};


// this function can be called in 2 ways:
//		1) Quaternion:rotate(&v);
//		2) v:rotate();
fn Quaternion:rotate(var q: &Quaternion)
{
	
}

// this function can also be called in 2 ways:
//		1) Quaternion:rotate(&v, &other, 0.25);
//		2) v:lerp(&other, 0.25);
// this is because the first parameter is of the type of the "namespace" this function is in
fn Quaternion:lerp(const qA: &Quaternion, const qB: &Quaternion, const t: f64) -> Quaternion
{
	var q: Quaternion = Quaternion { x = 0, y = 0, z = 0, w = 0 };

	q.x = qA.x + (qB.x - qA.x) * t;
	q.y = qA.y + (qB.y - qA.y) * t;
	q.z = qA.z + (qB.z - qA.z) * t;
	q.w = qA.w + (qB.x - qA.w) * t;

	return q;
}

fn Vector3:print(const v : &Vector3)
