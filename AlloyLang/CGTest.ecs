extern printf (const str : String, ...) -> i64;


/* Math Utilities */

type Vector3 = struct
{
	x: f64,
	y: f64,
	z: f64,
};

type Quaternion = struct
{
	x: f64,
	y: f64,
	z: f64,
	w: f64,
};


// this function can be called in 2 ways:
//		1) Quaternion:rotate(&v);
//		2) v:rotate();
fn Quaternion:rotate(var q: &Quaternion)
{
	
}

// this function can also be called in 2 ways:
//		1) Quaternion:rotate(&v, &other, 0.25);
//		2) v:lerp(&other, 0.25);
// this is because the first parameter is of the type of the "namespace" this function is in
fn Quaternion:lerp(const qA: &Quaternion, const qB: &Quaternion, const t: f64) -> Quaternion
{
	var q: Quaternion = Quaternion { x = 0, y = 0, z = 0, w = 0 };

	q.x = qA.x + (qB.x - qA.x) * t;
	q.y = qA.y + (qB.y - qA.y) * t;
	q.z = qA.z + (qB.z - qA.z) * t;
	q.w = qA.w + (qB.x - qA.w) * t;

	return q;
}

fn Vector3:print(const v : &Vector3)
{
	printf("[ %f, %f, %f ]", v.x, v.y, v.z);
}

fn Vector3:translate(const point : &Vector3, const vector : &Vector3) -> Vector3
{
	var result: Vector3 = Vector3 { x = 0.00, y = 0.00, z = 0.00 };
					
	result.x = point.x + vector.x;
	result.y = point.y + vector.y;
	result.z = point.z + vector.z;
					
	return result;
}


/* Rendering Utilities */

fn draw_mesh(const vertices : *[Vector3], const num_vertices : u32, const indices : *[i32], const num_indices : u32, const color : Vector3)
{
	printf("Drawing mesh with %d vertices and %d indices and with color (%lf, %lf, %lf).\n", num_vertices, num_indices, color.x, color.y, color.z);
}


/* Scene Resources */

resource RootEntity = struct
{
	id: i32,
};

resource CurrentScene = struct
{
	id: i32,
};


/* Transform Components */

component LocalTransform = struct
{
	position: Vector3,
	rotation: Quaternion,
	scale: Vector3,
};

component WorldTransform = struct
{
	position: Vector3,
	rotation: Quaternion,
	scale: Vector3,
};


/* Hierarchical Components */

component Parent = struct
{
	parent: i32,
};

component Child = struct
{
	first_child: i32,
};

component Sibling = struct
{
	next_sibling: i32,
};


/* Rendering Components */

component Mesh = struct
{
	vertices: *[Vector3],
	indices: *[i32],
};

component Material = struct
{
	shader_index: i32,
	color: Vector3,
};


/* Physics Components */

component RigidBody = struct
{
	mass: f64,
	velocity : Vector3,
	angular_velocity : Vector3,
};

component Collider = struct
{
	shape : i32,
};


/* AI Components */

#[exclude(Enemy)]
component Ally = i32;

#[exclude(Ally)]
component Enemy = i32;

/* Systems */

query SceneQuery
{
	var WorldTransform;
}

#[inline]
system load_scene(SceneQuery)
{
	printf("Loading scene.\n");
}

query TransformHierarchyQuery
{
	var WorldTransform;
	const LocalTransform;
	const Child;
	const Sibling;
}

system calculate_world_transforms(TransformHierarchyQuery)
{
	printf("Calculating world transforms.\n");
}


query RenderQuery
{
	const WorldTransform;
	const Mesh;
	const Material;
}

system render(const CurrentScene, RenderQuery)
{
	printf("Rendering meshes.\n");
}


query PhysicsQuery
{
	const WorldTransform;
	const RigidBody;
	const Collider;
}

system update_physics(PhysicsQuery)
{
	printf("Updating physics.\n");
}

system save()
{
	printf("Saving game.\n");
}


/* Groups */

group PreStartGroup
{
	load_scene
}

group StartGroup
{
	calculate_world_transforms
}

group UpdateGroup
{
	update_physics,
}

group RenderGroup
{
	render
}

group EndGroup
{
	save
}


/* Application */

application App
{
	start
	{
		PreStartGroup,
		StartGroup
	}

	update
	{
		UpdateGroup,
		RenderGroup
	}

	end
	{
		EndGroup
	}
}
