extern fn printf (const str : String, const param : i64) -> i64;

const res : i64 = 0;
var e : f32 = 1.0;

fn add (const a : &i64, const b : &i64) -> i64
{
	return (a + b);
}

fn mul (const a : &i64, const b : &i64) -> i64
{
	var ret : i64 = 0;
	if (a == 1)
		ret = b;
	else {
		for (var i : i64 = 0; i < a; i = i + 1) {
			ret = add(ret, b);
		}
	}
	return ret;
}

fn main () -> i64
{
	printf("3 x 5 = %f", mul(3, 5));
	return 0;
}
