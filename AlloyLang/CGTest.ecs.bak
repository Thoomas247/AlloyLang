const res : i64 = 0;
var e : f32 = 1.0;

fn add (const a : &i64, const b : &i64) -> i64
{
	return (a + b);
}

fn mul (const c : &i64, const d : &i64) -> i64
{
	if (c == 1)
		return d;
	else {
		var val : i64 = 0;
		for (var i : i64 = 0; i < c; i = i + 1) {
			val = val + d;
		}	
		return val;
	}
}

extern fn printf (const str : String) -> i64;

fn main () -> i64
{
	printf("Hello !");
	return mul(3, 5);
}
